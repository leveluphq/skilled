{
  "name": "@skilled/web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "NODE_OPTIONS=--max_old_space_size=8192 next",
    "build": "next build",
    "start": "next start",
    "setup:env": "node scripts/setup-env.js",
    "check:setup": "node scripts/check-setup.js",
    "codegen:client": "graphql-codegen --config codegen:client.yml",
    "codegen:server": "graphql-codegen --config codegen:server.yml",
    "codegen:all": "npm run codegen:client && npm run codegen:server",
    "ts": "tsc --noEmit true",
    "test": "jest",
    "conformance": "jest -c jest.conformance.config.js",
    "runner:images": "node scripts/runner-images.js",
    "runner:generate": "node scripts/generate-runner-preludes.js && node scripts/generate-runner-specs.js && node scripts/generate-lesson-languages.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "contentgen:lesson:pages": "node src/scripts/generateLessonPages.js",
    "contentgen:blog:slugs": "node src/scripts/generateBlogSlugs.js",
    "contentgen:slugs": "npm run contentgen:lesson:pages && npm run contentgen:blog:slugs",
    "contentgen:sitemaps": "node src/scripts/generateSitemap",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "contentgen:resources": "node src/scripts/generateResources.js",
    "contentgen:walkthroughs": "node src/scripts/generateWalkthroughs.js",
    "check:content": "node src/scripts/checkResources.js",
    "check:seo": "python3 scripts/check-public-seo.py",
    "test:seo-audit": "python3 -m unittest discover -s test/seo -p 'test_*.py'",
    "test:content:languages": "python3 scripts/check-resource-examples.py",
    "test:content:walkthroughs": "python3 scripts/check-walkthrough-examples.py",
    "prebuild": "npm run contentgen:resources && npm run contentgen:walkthroughs && npm run contentgen:videos && npm run check:content",
    "contentgen:videos": "node src/scripts/generateVideos.js",
    "test:content:curriculum": "jest -c jest.walkthroughs.config.js",
    "test:content:foundations": "jest -c jest.foundations.config.js"
  },
  "dependencies": {
    "@apollo/client": "^3.3.10",
    "@apollo/react-hooks": "^4.0.0",
    "@apollo/react-ssr": "^4.0.0",
    "@carbon/icons-react": "^10.9.1",
    "@mapbox/rehype-prism": "^0.9.0",
    "@mdx-js/loader": "^2.2.1",
    "@mdx-js/react": "^2.2.1",
    "@next/mdx": "^12.3.7",
    "@sentry/browser": "^7.120.4",
    "@sentry/node": "^7.120.4",
    "codemirror": "^5.52.0",
    "content-type": "^1.0.4",
    "cookie": "^0.7.2",
    "copy-to-clipboard": "^3.3.3",
    "dotenv": "^8.2.0",
    "focus-trap-react": "^6.0.0",
    "formik": "^2.1.4",
    "google-auth-library": "^11.3.1",
    "graphql": "^14.6.0",
    "graphql-tag": "^2.10.1",
    "is-hotkey": "^0.1.6",
    "isomorphic-unfetch": "^3.0.0",
    "jsonwebtoken": "^9.0.3",
    "lodash.get": "^4.4.2",
    "micro-cookie": "^1.2.0",
    "micro-redirect": "^1.0.0",
    "next": "^12.3.7",
    "next-images": "^1.8.4",
    "raw-body": "^2.4.1",
    "react": "^17.0.1",
    "react-aria-modal": "^4.0.0",
    "react-codemirror2": "^7.0.0",
    "react-content-loader": "^5.1.4",
    "react-dom": "^17.0.1",
    "react-headroom": "^3.0.0",
    "react-icons": "^3.9.0",
    "react-player": "^2.6.2",
    "react-ticker": "^1.2.2",
    "request-ip": "^3.3.0",
    "stripe": "^8.119.0",
    "styled-components": "^5.3.6",
    "use-debounce": "^3.4.3",
    "yup": "^0.28.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^1.20.0",
    "@graphql-codegen/typescript": "^1.20.0",
    "@graphql-codegen/typescript-operations": "^1.17.3",
    "@graphql-codegen/typescript-react-apollo": "^2.2.1",
    "@next/bundle-analyzer": "^12.3.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^12.1.5",
    "@testing-library/user-event": "^14.6.7",
    "@types/carbon__icons-react": "^10.6.0",
    "@types/codemirror": "^0.0.87",
    "@types/content-type": "^1.1.3",
    "@types/cookie": "^0.6.0",
    "@types/is-hotkey": "^0.1.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^8.3.5",
    "@types/lodash": "^4.14.149",
    "@types/lodash.get": "^4.4.6",
    "@types/node": "^22",
    "@types/react": "^16.9.23",
    "@types/react-aria-modal": "^4.0.1",
    "@types/react-dom": "^16.9.5",
    "@types/react-headroom": "^2.2.1",
    "@types/request-ip": "^0.0.35",
    "@types/stripe-v3": "^3.1.21",
    "@types/styled-components": "^5.1.4",
    "@types/yup": "^0.26.33",
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "node-mocks-http": "^1.18.1",
    "ts-jest": "^29.4.15",
    "typescript": "^4.9.5"
  },
  "optionalDependencies": {
    "@typescript/typescript-darwin-arm64": "7.0.2",
    "@typescript/typescript-darwin-x64": "7.0.2",
    "@typescript/typescript-linux-arm64": "7.0.2",
    "@typescript/typescript-linux-x64": "7.0.2"
  },
  "overrides": {
    "@babel/traverse": "^7.29.10",
    "@tootallnate/once": "^2.0.1",
    "cookie": "$cookie",
    "eventsource@^1": "^1.1.2",
    "form-data@^4": "^4.0.6",
    "immutable": "^3.8.4",
    "jsonwebtoken": "$jsonwebtoken",
    "lodash": "^4.18.1",
    "minimatch@^3": "^3.1.5",
    "node-fetch@^2": "^2.7.0",
    "package-json": "^7.0.0",
    "postcss": "^8.5.30",
    "prismjs": "^1.30.0",
    "tmp": "^0.2.7",
    "ws@^7": "^7.5.13"
  }
}

# ============================================================================
# Hasura CLI - Environment Variables (optional)
# ============================================================================
# The Hasura CLI (`hasura --project hasura ...`) reads hasura/.env, so with
# this copied there you can skip exporting HASURA_GRAPHQL_ENDPOINT and
# HASURA_GRAPHQL_ADMIN_SECRET before its commands (docs/README.md, step 4).
# Variables exported in your shell take precedence over this file.
#
#   cp hasura/.env.example hasura/.env
#
# scripts/course-seed.js reads it with `--env-file hasura/.env`.
# ============================================================================

# The local Hasura that hasura/docker-compose.yml starts
HASURA_GRAPHQL_ENDPOINT=http://localhost:8080

# The local-only admin secret hasura/docker-compose.yml starts Hasura with,
# the same as in .env.example. Anywhere else, use your own
# (openssl rand -base64 64 | tr -d '\n') and keep it out of git.
HASURA_GRAPHQL_ADMIN_SECRET=changeme_changeme_changeme_changeme_changeme_changeme_changeme_changeme_changeme_changeme

# For another Hasura, such as production, put its endpoint and admin secret in
# a file of their own (hasura/.env.prod.local is gitignored) and pass it:
#   hasura --project hasura --envfile .env.prod.local migrate status --database-name default
#   node scripts/course-seed.js diff --env-file hasura/.env.prod.local

# ============================================================================
# Skilled.dev Web Application - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your actual values, or run
# `npm run setup:env`, which does steps 1 and 2
# NEVER commit .env.local to git - it contains secrets!
#
# Quick Start (docs/README.md has the details):
# 1. Copy: cp .env.example .env.local
# 2. Generate JWT_SECRET and ENCRYPTION_KEY: see instructions below
# 3. Optional: create a GitHub OAuth app to log in (see the OAuth section).
#    Every lesson opens without logging in (OPEN_ALL_LESSONS below).
# 4. Replace the placeholders of anything else you set up
# ============================================================================

# ----------------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------------

# Application stage (development, staging, production)
APP_STAGE=development

# Root domain for cookies (e.g., localhost, skilled.dev)
ROOT_DOMAIN=localhost

# Full URL of the application (used for OAuth callbacks)
ROOT_URL=http://localhost:3000

# Public site metadata. Forks can set their own publisher identity and image.
SITE_NAME=Skilled.dev
# SITE_DESCRIPTION=Your site's description
# SITE_IMAGE=https://your-domain.example/social-share.png
# SITE_LOGO=https://your-domain.example/logo-square.png
# SITE_TWITTER=@your_account
# Public indexing requires APP_STAGE=production. Set false for a private mirror.
SITE_INDEXABLE=true

# ----------------------------------------------------------------------------
# Lessons
# ----------------------------------------------------------------------------

# Open every lesson to everyone, logged in or not, so you can read and run the
# whole course without setting up login. Remove it to make lessons need an
# account, as they do on skilled.dev.
OPEN_ALL_LESSONS=true

# ----------------------------------------------------------------------------
# Database & API
# ----------------------------------------------------------------------------

# Hasura GraphQL endpoint
# Development: http://localhost:8080/v1/graphql
# Production: https://api.skilled.dev/v1/graphql
GRAPHQL_URL=http://localhost:8080/v1/graphql

# Hasura admin secret. This is the local-only value hasura/docker-compose.yml
# starts Hasura with; anywhere else, use your own (openssl rand -base64 64 | tr -d '\n').
HASURA_GRAPHQL_ADMIN_SECRET=changeme_changeme_changeme_changeme_changeme_changeme_changeme_changeme_changeme_changeme

# ----------------------------------------------------------------------------
# Authentication & Security
# ----------------------------------------------------------------------------

# JWT token cookie name (can be any unique identifier)
JWT_TOKEN_NAME=stoken-local

# JWT secret for signing tokens (REQUIRED: 64-byte base64-encoded)
# Generate with: openssl rand -base64 64 | tr -d '\n' (or npm run setup:env)
# IMPORTANT: This MUST be a cryptographically secure 64-byte secret
JWT_SECRET=your-jwt-secret-here-must-be-64-bytes-base64-encoded

# Encryption key for OAuth tokens (REQUIRED: 64-byte base64-encoded)
# Generate with: openssl rand -base64 64 | tr -d '\n' (or npm run setup:env)
# IMPORTANT: This MUST be a cryptographically secure 64-byte secret
ENCRYPTION_KEY=your-encryption-key-here-must-be-64-bytes-base64-encoded

# OLD encryption key (only during key rotation)
# When rotating keys, set this to your old key temporarily
# ENCRYPTION_KEY_OLD=your-old-encryption-key-during-rotation

# ----------------------------------------------------------------------------
# Payment Processing - Stripe (optional)
# ----------------------------------------------------------------------------

# Only for selling the course. Without STRIPE_SECRET_KEY, logging in still
# works and the pricing page says there's nothing for sale.

# Stripe publishable key (safe to expose in client)
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Stripe secret key (NEVER expose in client!)
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_test_your-secret-key

# Stripe webhook secret for signature verification
# Get from: https://dashboard.stripe.com/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ----------------------------------------------------------------------------
# OAuth - GitHub
# ----------------------------------------------------------------------------

# Logging in needs one of the OAuth apps below, plus JWT_SECRET and
# ENCRYPTION_KEY. GitHub's is the quickest to set up for local development.

# Create a GitHub OAuth App:
# 1. Go to: https://github.com/settings/developers
# 2. Click "New OAuth App"
# 3. Set Homepage URL: http://localhost:3000
# 4. Set Authorization callback URL: http://localhost:3000/api/auth/github/callback
# 5. Copy Client ID and generate Client Secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ----------------------------------------------------------------------------
# OAuth - Google
# ----------------------------------------------------------------------------

# Create a Google OAuth 2.0 Client:
# 1. Go to: https://console.cloud.google.com/apis/credentials
# 2. Create a new project or select existing
# 3. Click "Create Credentials" > "OAuth client ID"
# 4. Application type: Web application
# 5. Add Authorized redirect URIs: http://localhost:3000/api/auth/google/callback
# 6. Copy Client ID and Client Secret

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ----------------------------------------------------------------------------
# OAuth - Facebook
# ----------------------------------------------------------------------------

# Create a Facebook App:
# 1. Go to: https://developers.facebook.com/apps
# 2. Click "Create App" > Select "For Everything Else"
# 3. Add "Facebook Login" product
# 4. In Settings > Basic, copy App ID and App Secret
# 5. In Facebook Login > Settings, add Valid OAuth Redirect URI:
#    http://localhost:3000/api/auth/facebook/callback

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ----------------------------------------------------------------------------
# Error Tracking - Sentry (optional)
# ----------------------------------------------------------------------------

# Without a DSN, errors aren't reported anywhere. A malformed one turns Sentry
# off with a message in the console.

# Sentry DSN for server-side error tracking
# Get from: https://sentry.io/settings/[org]/projects/[project]/keys/
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Sentry DSN for client-side error tracking
# SENTRY_DSN_CLIENT=https://your-client-sentry-dsn@sentry.io/project-id

# Sentry organization and project details (for source map uploads)
# SENTRY_URL=https://sentry.io/
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ----------------------------------------------------------------------------
# Analytics (optional)
# ----------------------------------------------------------------------------

# Google Tag Manager container ID
# Get from: https://tagmanager.google.com/
# GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# ----------------------------------------------------------------------------
# Email Service - SendinBlue (Brevo)
# ----------------------------------------------------------------------------

# SendinBlue API key for transactional emails
# Get from: https://app.brevo.com/settings/keys/api
SENDINBLUE_API_KEY=xkeysib-your-sendinblue-api-key

# Email address for internal notifications
INTERNAL_NOTIFICATION_EMAIL=admin@yourdomain.com

# ----------------------------------------------------------------------------
# Code Execution
# ----------------------------------------------------------------------------

# Where learners' code runs:
#   docker   on this machine, in throwaway containers (run `npm run runner:images` once)
#   system   on this machine, with its own Node.js and Python: JavaScript,
#            TypeScript and Python without Docker. No sandbox, so only for
#            running your own code, with the app at localhost
#   service  on the runner service at RUNNER_SERVICE_URL (docs/runner-service.md)
#   judge0   on the hosted Judge0 below (JavaScript, TypeScript and Python only)
# Defaults to judge0 when JUDGE0_API_KEY is set, and docker otherwise.
# See "Run Lesson Code" in docs/README.md.
# CODE_RUNNER=docker

# With CODE_RUNNER=system, the Node.js and Python that run programs: by default
# the Node.js running the app, and python3 on your PATH
# RUNNER_NODE=/path/to/node
# RUNNER_PYTHON=/path/to/python3

# The runner service (CODE_RUNNER=service): its URL and shared secret
# RUNNER_SERVICE_URL=https://skilled-runner.your-subdomain.workers.dev
# RUNNER_SERVICE_SECRET=

# How often each learner may run code: <runs>/<number><s|m|h|d>, or off.
# They apply when code runs on the runner service or Judge0 (RUN_LIMITS=on or
# off overrides that). Logged-out visitors are counted by a hash of their IP
# address, keyed with RUN_LIMIT_SECRET (JWT_SECRET if unset).
# RUN_LIMIT_ANONYMOUS=30/10m
# RUN_LIMIT_USER=120/10m
# RUN_LIMIT_TOTAL=2000/1h
# RUN_LIMITS=
# RUN_LIMIT_SECRET=

# On Judge0, which lessons run on the new runner: `all`, or a comma-separated
# list of lesson slugs. The rest keep the old runner. Docker always uses the
# new runner.
# RUNNER_V2_LESSONS=all

# Judge0 API key for code execution sandbox
# Get from: https://rapidapi.com/judge0-official/api/judge0-ce
# JUDGE0_API_KEY=your-judge0-api-key

# Shared secret used to verify Judge0 callback authenticity
# Generate with: openssl rand -hex 32
# JUDGE0_CALLBACK_SECRET=your-judge0-callback-secret

# Public base URL Judge0 sends results to (/api/v1/judge0/callback/<id>).
# Defaults to ROOT_URL. Judge0 can't reach localhost, so for local development
# set it to a tunnel to your dev server, e.g. `ngrok http 3000`.
# JUDGE0_CALLBACK_BASE_URL=https://your-tunnel.ngrok-free.app

# ============================================================================
# Security Checklist
# ============================================================================
# Before deploying to production:
# [ ] All secrets are cryptographically secure (not placeholder values)
# [ ] JWT_SECRET and ENCRYPTION_KEY are 64-byte base64-encoded
# [ ] Secrets are different between staging and production
# [ ] OAuth callback URLs match your production domain
# [ ] Stripe keys are for correct environment (test vs live)
# [ ] .env.local is in .gitignore and not committed
# [ ] Environment variables are set in hosting platform (e.g., Vercel)
# ============================================================================
